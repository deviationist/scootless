# Copy to .env and fill in. .env is gitignored - your coordinates stay yours.

# Where you stand when you ask. Decimal degrees.
# (This example is Karl Johans gate, Oslo - replace it.)
SCOOTLESS_LAT=59.9139
SCOOTLESS_LON=10.7522

# Search radius in metres.
SCOOTLESS_RADIUS=100

# Warn when this many or fewer are left.
SCOOTLESS_THRESHOLD=3

# ryde, voi, bolt, dott, "all", or a comma-separated subset.
# Set this to the one operator you have a subscription with.
SCOOTLESS_OPERATOR=all

# Sent as ET-Client-Name. Entur asks that API users identify themselves;
# anything recognisable is fine.
SCOOTLESS_CLIENT_NAME=scootless

# --- Notifications -----------------------------------------------------------
# Where fired watches are published. MQTT is a bus, not a destination: whatever
# ends up notifying your phone subscribes to this rather than being wired in.
# Leave empty and notifications are logged instead, which is enough to develop
# against.
#
# Both plain MQTT (tcp://host:1883) and MQTT-over-WebSocket (ws:// or wss://)
# work. A WebSocket URL is useful where only 443 is reachable.
SCOOTLESS_MQTT_BROKER=
SCOOTLESS_MQTT_USERNAME=
SCOOTLESS_MQTT_PASSWORD=
SCOOTLESS_MQTT_CLIENT_ID=scootless
SCOOTLESS_MQTT_TOPIC=scootless

# --- Daemon ------------------------------------------------------------------
# Where scootlessd listens. Keep it on loopback unless a token is set below.
SCOOTLESS_HTTP_ADDR=127.0.0.1:8099

# Required as a bearer token on /api/ when set. Empty means the API is open,
# which is only acceptable while it is bound to loopback.
SCOOTLESS_API_TOKEN=

# How often to poll. Measured, the feed changes about every 15s across all
# operators, and a fixed interval adds half of itself to every notification —
# so this is the main latency knob. There is a 5s floor; see the README.
SCOOTLESS_INTERVAL=10s

# Where the database lives. Defaults to ~/.local/state/scootless/scootless.db
SCOOTLESS_DB=

# --- ntfy --------------------------------------------------------------------
# The hop that actually reaches a phone. ntfy has a real iOS and Android app,
# and can be self-hosted or used via ntfy.sh.
#
# On a public server the topic name is the ONLY thing keeping your
# notifications private - anyone who knows it can read them, and send them.
# Use something long and random, not "scooters".
SCOOTLESS_NTFY_SERVER=
SCOOTLESS_NTFY_TOPIC=
# Only needed by a server that requires auth.
SCOOTLESS_NTFY_TOKEN=
# 1-5. Left empty, appearance alerts go out high and scarcity warnings normal.
SCOOTLESS_NTFY_PRIORITY=

# Browser origins allowed to call the API cross-origin (comma-separated).
# Empty (the default) disables CORS entirely, which is right for a loopback
# bind. Exact match on scheme + host + port; no trailing slash.
SCOOTLESS_ALLOWED_ORIGINS=
