# Copy to .env and fill in. .env is gitignored - your coordinates stay yours.

# Where you stand when you ask. Decimal degrees.
# (This example is Karl Johans gate, Oslo - replace it.)
SCOOTLESS_LAT=59.9139
SCOOTLESS_LON=10.7522

# Search radius in metres.
SCOOTLESS_RADIUS=100

# Warn when this many or fewer are left.
SCOOTLESS_THRESHOLD=3

# ryde, voi, bolt, dott, "all", or a comma-separated subset.
# Set this to the one operator you have a subscription with.
SCOOTLESS_OPERATOR=all

# Sent as ET-Client-Name. Entur asks that API users identify themselves;
# anything recognisable is fine.
SCOOTLESS_CLIENT_NAME=scootless
